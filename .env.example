# =============================================================
# מערכת הדרכת אבטחת מידע — גירון פיתוח ובניה בע"מ
# העתק קובץ זה ל-.env ועדכן את כל הערכים לפני ההפעלה
# =============================================================

# --- Application ---
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://security.giron.co.il   # עדכן לכתובת האמיתית

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=giron_security
DB_USER=giron_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD     # לפחות 20 תווים, אותיות + מספרים + סימנים
DB_SSL=false

# --- JWT Authentication ---
# צור מפתח: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# --- Email (SMTP) ---
SMTP_HOST=smtp.office365.com                 # עדכן לשרת המייל שלך
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=security-training@giron.co.il      # כתובת שולח המייל
SMTP_PASS=CHANGE_ME_EMAIL_PASSWORD           # סיסמת חשבון המייל
EMAIL_FROM='"מערכת הדרכת אבטחה - גירון" <security-training@giron.co.il>'

# --- Admin Account (first-run seeder) ---
ADMIN_EMAIL=admin@giron.co.il
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD      # שנה מיד לאחר כניסה ראשונה!
ADMIN_NAME=מנהל מערכת

# --- Security ---
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=logs/app.log
